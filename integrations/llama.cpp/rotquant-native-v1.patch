+constexpr uintptr_t RQ_KV_STORE_V_MAGIC = 0x52514b5653544f56ULL; // "RQKVSTOV"
+constexpr uintptr_t RQ_KV_LOAD_K_MAGIC  = 0x52514b564c4f414bULL; // "RQKVLOAK"
+constexpr uintptr_t RQ_KV_LOAD_V_MAGIC  = 0x52514b564c4f4156ULL; // "RQKVLOAV"
+
+constexpr int64_t RQ_KV_GROUP_SIZE = 64;
+
+// rotquant.codebooks.lloyd_max_gaussian(16), rounded once to float32.
+constexpr float RQ_CODEBOOK[16] = {
+    -2.7338738441467285f, -2.0704751014709473f,
+    -1.6195980310440063f, -1.2577794790267944f,
+    -0.9437850117683411f, -0.6579855084419250f,
+    -0.3889232873916626f, -0.1287587136030197f,
+     0.1286393851041794f,  0.3888039886951447f,
+     0.6578662991523743f,  0.9436659216880798f,
+     1.2576605081558228f,  1.6195257902145386f,
+     2.0704751014709473f,  2.7338738441467285f,
+};
+
+constexpr float RQ_KV_CODEBOOK_2[4] = {
+    -1.510466456413269f, -0.45277151465415955f,
+     0.4528822898864746f, 1.5105623006820679f,
+};
+
+constexpr float RQ_KV_CODEBOOK_3[8] = {
+    -2.1523044109344482f, -1.3442617654800415f,
+    -0.7562991976737976f, -0.2452515810728073f,
+     0.24513407051563263f, 0.7562323808670044f,
+     1.3442617654800415f, 2.1523044109344482f,
+};
+
+constexpr uint32_t RQ_KV_KEY_SIGNS[8] = {
+    0x5e6827f6u, 0x597afa6du, 0x4dfa58c1u, 0xdf505896u,
+    0xba3d309bu, 0x41515534u, 0x8a0c6522u, 0xdc7a58f3u,
+};
+
+constexpr uint32_t RQ_KV_VALUE_SIGNS[8] = {
+    0x112269f3u, 0x65c9bf1fu, 0x72d970cfu, 0x7e07f07bu,
+    0x42e2be26u, 0x0846481du, 0xf7637073u, 0xcfd5db52u,
+};
+
+const char * row_ptr(const ggml_tensor * tensor, int64_t row) {
+    int64_t i1 = row % tensor->ne[1];
+    row /= tensor->ne[1];
+    int64_t i2 = row % tensor->ne[2];
+    int64_t i3 = row / tensor->ne[2];
+    return static_cast<const char *>(tensor->data)
+        + i1 * tensor->nb[1] + i2 * tensor->nb[2] + i3 * tensor->nb[3];
+}
+
+char * row_ptr(ggml_tensor * tensor, int64_t row) {
+    return const_cast<char *>(row_ptr(const_cast<const ggml_tensor *>(tensor), row));
+}
+
+const float * kv_codebook(int bits) {
+    if (bits == 2) {
+        return RQ_KV_CODEBOOK_2;
+    }
+    if (bits == 3) {
+        return RQ_KV_CODEBOOK_3;
+    }
+    GGML_ASSERT(bits == 4);
+    return RQ_CODEBOOK;
+}
+
+float kv_sign(int64_t element, bool value) {
+    const uint32_t * masks = value ? RQ_KV_VALUE_SIGNS : RQ_KV_KEY_SIGNS;
+    const uint32_t word = masks[(element % 256) / 32];
+    return ((word >> (element % 32)) & 1u) ? 1.0f : -1.0f;
+}
+
+void kv_fwht(std::vector<float> & values) {
+    GGML_ASSERT(values.size() % RQ_ROTATION_BLOCK == 0);
+    constexpr float norm = 0.08838834764831845f; // 1/sqrt(128)
+    for (size_t base = 0; base < values.size(); base += RQ_ROTATION_BLOCK) {
+        for (int64_t step = 1; step < RQ_ROTATION_BLOCK; step *= 2) {
+            for (int64_t group = 0; group < RQ_ROTATION_BLOCK; group += 2*step) {
+                for (int64_t j = 0; j < step; ++j) {
+                    const float a = values[base + group + j];
+                    const float b = values[base + group + step + j];
+                    values[base + group + j] = a + b;
+                    values[base + group + step + j] = a - b;
+                }
+            }
+        }
+        for (int64_t j = 0; j < RQ_ROTATION_BLOCK; ++j) {
+            values[base + j] *= norm;
+        }
+    }
+}
+
+void kv_rotate(std::vector<float> & values, bool value) {
+    for (size_t i = 0; i < values.size(); ++i) {
+        values[i] *= kv_sign(i, value);
+    }
+    kv_fwht(values);
+}
+
+void kv_inverse_rotate(std::vector<float> & values, bool value) {
+    kv_fwht(values);
+    for (size_t i = 0; i < values.size(); ++i) {
+        values[i] *= kv_sign(i, value);
+    }
+}
+
+float tensor_value(const ggml_tensor * tensor, int64_t i0, int64_t i1, int64_t i2) {
+    const char * ptr = static_cast<const char *>(tensor->data)
+        + i0*tensor->nb[0] + i1*tensor->nb[1] + i2*tensor->nb[2];
+    switch (tensor->type) {
+        case GGML_TYPE_F32: return *reinterpret_cast<const float *>(ptr);
+        case GGML_TYPE_F16: return ggml_fp16_to_fp32(*reinterpret_cast<const ggml_fp16_t *>(ptr));
+        case GGML_TYPE_BF16: return ggml_bf16_to_fp32(*reinterpret_cast<const ggml_bf16_t *>(ptr));
+        default: GGML_ABORT("unsupported RotQuant KV input type");
+    }
+}
+
+uint8_t kv_nearest_code(float value, const float * codebook, int bits) {
+    uint8_t best = 0;
+    float best_error = std::fabs(value - codebook[0]);
+    for (int i = 1; i < (1 << bits); ++i) {
+        const float error = std::fabs(value - codebook[i]);
+        if (error < best_error) {
+            best = static_cast<uint8_t>(i);
+            best_error = error;
+        }
+    }
+    return best;
+}
+
+void kv_pack_head(uint8_t * dst, std::vector<float> & values, int bits, bool value) {
+    kv_rotate(values, value);
+    const float * codebook = kv_codebook(bits);
+    const int64_t code_bytes = RQ_KV_GROUP_SIZE*bits/8;
+    const int64_t group_bytes = RQ_SCALE_BYTES + code_bytes;
+    for (size_t group = 0; group < values.size()/RQ_KV_GROUP_SIZE; ++group) {
+        float sum_sq = 0.0f;
+        for (int64_t j = 0; j < RQ_KV_GROUP_SIZE; ++j) {
+            const float x = values[group*RQ_KV_GROUP_SIZE + j];
+            sum_sq += x*x;
+        }
+        const float rms = std::max(std::sqrt(sum_sq/RQ_KV_GROUP_SIZE), 0x1p-14f);
+        const ggml_fp16_t scale_bits = ggml_fp32_to_fp16(rms);
+        const float scale = ggml_fp16_to_fp32(scale_bits);
+        uint8_t * packed = dst + group*group_bytes;
+        std::memcpy(packed, &scale_bits, sizeof(scale_bits));
+        std::memset(packed + RQ_SCALE_BYTES, 0, code_bytes);
+        for (int64_t j = 0; j < RQ_KV_GROUP_SIZE; ++j) {
+            const uint8_t code = kv_nearest_code(
+                values[group*RQ_KV_GROUP_SIZE + j]/scale, codebook, bits);
+            const int64_t bit = j*bits;
+            const int64_t byte = bit/8;
+            const int shift = bit%8;
+            const uint16_t encoded = static_cast<uint16_t>(code) << shift;
+            packed[RQ_SCALE_BYTES + byte] |= static_cast<uint8_t>(encoded);
+            if (shift + bits > 8) {
+                packed[RQ_SCALE_BYTES + byte + 1] |= static_cast<uint8_t>(encoded >> 8);
+            }
+        }
+    }
+}
+
+void kv_unpack_head(const uint8_t * src, std::vector<float> & values, int bits, bool value) {
+    const float * codebook = kv_codebook(bits);
+    const int64_t code_bytes = RQ_KV_GROUP_SIZE*bits/8;
+    const int64_t group_bytes = RQ_SCALE_BYTES + code_bytes;
+    const uint16_t mask = (1u << bits) - 1u;
+    for (size_t group = 0; group < values.size()/RQ_KV_GROUP_SIZE; ++group) {
+        const uint8_t * packed = src + group*group_bytes;
+        ggml_fp16_t scale_bits;
+        std::memcpy(&scale_bits, packed, sizeof(scale_bits));
+        const float scale = ggml_fp16_to_fp32(scale_bits);
+        for (int64_t j = 0; j < RQ_KV_GROUP_SIZE; ++j) {
+            const int64_t bit = j*bits;
+            const int64_t byte = bit/8;
+            const int shift = bit%8;
+            uint16_t encoded = packed[RQ_SCALE_BYTES + byte];
+            if (shift + bits > 8) {
+                encoded |= static_cast<uint16_t>(packed[RQ_SCALE_BYTES + byte + 1]) << 8;
+            }
+            const uint8_t code = static_cast<uint8_t>((encoded >> shift) & mask);
+            values[group*RQ_KV_GROUP_SIZE + j] = scale*codebook[code];
+        }
+    }
+    kv_inverse_rotate(values, value);
+}
+
+int kv_bits_from_layout(int64_t packed_row, int64_t n_embd_gqa) {
+    GGML_ASSERT(n_embd_gqa % RQ_KV_GROUP_SIZE == 0);
+    const int64_t groups = n_embd_gqa/RQ_KV_GROUP_SIZE;
+    const int64_t code_bytes = packed_row/groups - RQ_SCALE_BYTES;
+    const int bits = static_cast<int>(code_bytes*8/RQ_KV_GROUP_SIZE);
+    GGML_ASSERT(bits >= 2 && bits <= 4);
+    GGML_ASSERT(packed_row == groups*(RQ_SCALE_BYTES + RQ_KV_GROUP_SIZE*bits/8));
+    return bits;
+}
+
+void compute_rotquant_kv_store(
+        ggml_tensor * dst,
+        int ith,
+        int nth,
+        void * userdata) {
+    const ggml_tensor * current = dst->src[1];
+    const ggml_tensor * indices = dst->src[2];
+    const bool value = reinterpret_cast<uintptr_t>(userdata) == RQ_KV_STORE_V_MAGIC;
+    const int64_t n_embd_head = current->ne[0];
+    const int64_t n_head = current->ne[1];
+    const int64_t n_tokens = current->ne[2];
+    const int bits = kv_bits_from_layout(dst->ne[0], n_embd_head*n_head);
+    const int64_t head_bytes = llama_rotquant_kv_row_size(n_embd_head, bits);
+    const int64_t * idx = static_cast<const int64_t *>(indices->data);
+    std::vector<float> values(n_embd_head);
+
+    for (int64_t token = ith; token < n_tokens; token += nth) {
+        GGML_ASSERT(idx[token] >= 0 && idx[token] < ggml_nrows(dst));
+        uint8_t * packed = reinterpret_cast<uint8_t *>(row_ptr(dst, idx[token]));
+        for (int64_t head = 0; head < n_head; ++head) {
+            for (int64_t j = 0; j < n_embd_head; ++j) {
+                values[j] = tensor_value(current, j, head, token);
+            }
+            kv_pack_head(packed + head*head_bytes, values, bits, value);
+        }
+    }
+}
+
+void compute_rotquant_kv_load(
+        ggml_tensor * dst,
+        int ith,
+        int nth,
+        void * userdata) {
+    const ggml_tensor * packed = dst->src[0];
+    const bool value = reinterpret_cast<uintptr_t>(userdata) == RQ_KV_LOAD_V_MAGIC;
+    const int64_t n_embd_head = dst->ne[0];
+    const int64_t n_head = dst->ne[1];
+    const int bits = kv_bits_from_layout(packed->ne[0], n_embd_head*n_head);
+    const int64_t head_bytes = llama_rotquant_kv_row_size(n_embd_head, bits);
+    std::vector<float> values(n_embd_head);
+
+    for (int64_t row = ith; row < ggml_nrows(dst); row += nth) {
+        const int64_t head = row % n_head;
+        const int64_t packed_row = row/n_head;
+        const uint8_t * src = reinterpret_cast<const uint8_t *>(row_ptr(packed, packed_row));
+        kv_unpack_head(src + head*head_bytes, values, bits, value);
+        ggml_fp16_t * output = reinterpret_cast<ggml_fp16_t *>(row_ptr(dst, row));
+        for (int64_t j = 0; j < n_embd_head; ++j) {
+            output[j] = ggml_fp32_to_fp16(values[j]);
+        }
+    }
+}
+
+void rotate_activation(
+        std::vector<float> & values,
+        const float        * rotation,
+        int64_t              n_embd) {
+    const float * signs = rotation;
+    const float * theta = rotation + n_embd;
+    const int64_t n_blocks = n_embd / RQ_ROTATION_BLOCK;
+
+    for (int64_t i = 0; i < n_embd; ++i) {
+        values[i] *= signs[i];
+    }
+
+    for (int64_t stage = 0; stage < RQ_ROTATION_STAGES; ++stage) {
+        const int64_t step = int64_t(1) << stage;
+        const int64_t groups = RQ_ROTATION_BLOCK / (2 * step);
+        for (int64_t block = 0; block < n_blocks; ++block) {
+            const int64_t block_base = block * RQ_ROTATION_BLOCK;
+            const float * stage_theta = theta
+                + (block * RQ_ROTATION_STAGES + stage) * (RQ_ROTATION_BLOCK / 2);
+            for (int64_t group = 0; group < groups; ++group) {
+                for (int64_t j = 0; j < step; ++j) {
+                    const int64_t pair = group * step + j;
+                    const int64_t ia = block_base + group * 2 * step + j;
+                    const int64_t ib = ia + step;
+                    const float a = values[ia];
+                    const float b = values[ib];
+                    const float c = std::cos(stage_theta[pair]);
+                    const float s = std::sin(stage_theta[pair]);
+                    values[ia] = c * a + s * b;
+                    values[ib] = s * a - c * b;
+                }
+            }
+        }
+    }
+}
+
+void inverse_rotate_activation(
+        std::vector<float> & values,
+        const float        * rotation,
+        int64_t              n_embd) {
+    const float * signs = rotation;
+    const float * theta = rotation + n_embd;
+    const int64_t n_blocks = n_embd / RQ_ROTATION_BLOCK;
+
+    for (int64_t stage = RQ_ROTATION_STAGES - 1; stage >= 0; --stage) {
+        const int64_t step = int64_t(1) << stage;
+        const int64_t groups = RQ_ROTATION_BLOCK / (2 * step);
+        for (int64_t block = 0; block < n_blocks; ++block) {
+            const int64_t block_base = block * RQ_ROTATION_BLOCK;
+            const float * stage_theta = theta
+                + (block * RQ_ROTATION_STAGES + stage) * (RQ_ROTATION_BLOCK / 2);
+            for (int64_t group = 0; group < groups; ++group) {
+                for (int64_t j = 0; j < step; ++j) {
+                    const int64_t pair = group * step + j;
+                    const int64_t ia = block_base + group * 2 * step + j;
+                    const int64_t ib = ia + step;
+                    const float a = values[ia];
+                    const float b = values[ib];
+                    const float c = std::cos(stage_theta[pair]);
+                    const float s = std::sin(stage_theta[pair]);
+                    values[ia] = c * a + s * b;
+                    values[ib] = s * a - c * b;
+                }
+            }
+        }
+    }
+    for (int64_t i = 0; i < n_embd; ++i) {
+        values[i] *= signs[i];
+    }
+}
+
+void compute_rotquant_rotate(
+        ggml_tensor * dst,
+        int           ith,
+        int           nth,
+        void        *) {
+    const ggml_tensor * input = dst->src[0];
+    const ggml_tensor * rotation = dst->src[1];
+
+    const int64_t n_embd = input->ne[0];
+    const int64_t n_rows = ggml_nrows(input);
+    const float * rotation_data = static_cast<const float *>(rotation->data);
+
+    std::vector<float> rotated(n_embd);
+    for (int64_t token = ith; token < n_rows; token += nth) {
+        const void * input_row = row_ptr(input, token);
+        if (input->type == GGML_TYPE_F32) {
+            std::memcpy(rotated.data(), input_row, n_embd * sizeof(float));
+        } else if (input->type == GGML_TYPE_F16) {
+            const ggml_fp16_t * values = static_cast<const ggml_fp16_t *>(input_row);
+            for (int64_t i = 0; i < n_embd; ++i) {
+                rotated[i] = ggml_fp16_to_fp32(values[i]);
+            }
+        } else if (input->type == GGML_TYPE_BF16) {
+            const ggml_bf16_t * values = static_cast<const ggml_bf16_t *>(input_row);
+            for (int64_t i = 0; i < n_embd; ++i) {
+                rotated[i] = ggml_bf16_to_fp32(values[i]);
+            }
+        } else {
+            const ggml_type_traits * traits = ggml_get_type_traits(input->type);
+            GGML_ASSERT(traits != nullptr && traits->to_float != nullptr);
+            traits->to_float(input_row, rotated.data(), n_embd);
+        }
+        rotate_activation(rotated, rotation_data, n_embd);
+        std::memcpy(row_ptr(dst, token), rotated.data(), n_embd * sizeof(float));
+    }
+}
+
+void compute_rotquant_mul_mat(
+        ggml_tensor * dst,
+        int           ith,
+        int           nth,
+        void        *) {
+    const ggml_tensor * qweight = dst->src[0];
+    const ggml_tensor * input = dst->src[1];
+
+    const int64_t n_embd = input->ne[0];
+    const int64_t n_groups = n_embd / RQ_GROUP_SIZE;
+    const int64_t n_outputs = qweight->ne[1];
+    const int64_t n_rows = ggml_nrows(input);
+
+    for (int64_t token = 0; token < n_rows; ++token) {
+        const float * rotated = reinterpret_cast<const float *>(row_ptr(input, token));
+        for (int64_t output = ith; output < n_outputs; output += nth) {
+            const uint8_t * qrow = reinterpret_cast<const uint8_t *>(qweight->data)
+                + output * qweight->nb[1];
+            float sum = 0.0f;
+            for (int64_t group = 0; group < n_groups; ++group) {
+                const uint8_t * packed = qrow + group * RQ_BLOCK_BYTES;
+                ggml_fp16_t scale_bits;
+                std::memcpy(&scale_bits, packed, sizeof(scale_bits));
+                const float scale = ggml_fp16_to_fp32(scale_bits);
+                const uint8_t * codes = packed + RQ_SCALE_BYTES;
+                const int64_t input_base = group * RQ_GROUP_SIZE;
+                float group_sum = 0.0f;
+                for (int64_t j = 0; j < RQ_CODE_BYTES; ++j) {
+                    const uint8_t pair = codes[j];
+                    group_sum += RQ_CODEBOOK[pair & 0x0f] * rotated[input_base + 2*j + 0];
+                    group_sum += RQ_CODEBOOK[pair >> 4]   * rotated[input_base + 2*j + 1];
+                }
+                sum += scale * group_sum;
+            }
+            float * output_row = reinterpret_cast<float *>(row_ptr(dst, token));
+            output_row[output] = sum;
+        }
+    }
+}
+
+void compute_rotquant_get_rows(
+        ggml_tensor * dst,
+        int           ith,
+        int           nth,
+        void        *) {
+    const ggml_tensor * qweight = dst->src[0];
+    const ggml_tensor * indices = dst->src[1];
+    const ggml_tensor * rotation = dst->src[2];
+    const int64_t n_embd = qweight->ne[0] / RQ_BLOCK_BYTES * RQ_GROUP_SIZE;
+    const int64_t n_rows = ggml_nelements(indices);
+    const int32_t * token_ids = static_cast<const int32_t *>(indices->data);
+    const float * rotation_data = static_cast<const float *>(rotation->data);
+    std::vector<float> values(n_embd);
+
+    for (int64_t row = ith; row < n_rows; row += nth) {
+        const int64_t token = token_ids[row];
+        GGML_ASSERT(token >= 0 && token < qweight->ne[1]);
+        const uint8_t * qrow = reinterpret_cast<const uint8_t *>(qweight->data)
+            + token * qweight->nb[1];
+        for (int64_t group = 0; group < n_embd / RQ_GROUP_SIZE; ++group) {
+            const uint8_t * packed = qrow + group * RQ_BLOCK_BYTES;
+            ggml_fp16_t scale_bits;
+            std::memcpy(&scale_bits, packed, sizeof(scale_bits));
+            const float scale = ggml_fp16_to_fp32(scale_bits);
+            const uint8_t * codes = packed + RQ_SCALE_BYTES;
+            const int64_t base = group * RQ_GROUP_SIZE;
+            for (int64_t j = 0; j < RQ_CODE_BYTES; ++j) {
+                const uint8_t pair = codes[j];
+                values[base + 2*j] = scale * RQ_CODEBOOK[pair & 0x0f];
+                values[base + 2*j + 1] = scale * RQ_CODEBOOK[pair >> 4];
+            }
+        }
+        inverse_rotate_activation(values, rotation_data, n_embd);
+        std::memcpy(row_ptr(dst, row), values.data(), n_embd * sizeof(float));
+    }
+}
+
+} // namespace
+
+ggml_tensor * llama_rotquant_mul_mat(
+        ggml_context * ctx,
+        ggml_tensor  * qweight,
+        ggml_tensor  * input,
+        ggml_tensor  * rotation) {
+    GGML_ASSERT(qweight->type == GGML_TYPE_I8);
+    GGML_ASSERT(rotation->type == GGML_TYPE_F32);
+    GGML_ASSERT(input->ne[0] % RQ_GROUP_SIZE == 0);
+    GGML_ASSERT(qweight->ne[0] == input->ne[0] / RQ_GROUP_SIZE * RQ_BLOCK_BYTES);
+    GGML_ASSERT(rotation->ne[0] == input->ne[0]
+        + input->ne[0] / 2 * RQ_ROTATION_STAGES);
+
+    ggml_tensor * rotate_args[] = { input, rotation };
+    ggml_tensor * rotated = ggml_custom_4d(
+        ctx,
+        GGML_TYPE_F32,
+        input->ne[0], input->ne[1], input->ne[2], input->ne[3],
+        rotate_args, 2,
+        compute_rotquant_rotate,
+        GGML_N_TASKS_MAX,
+        reinterpret_cast<void *>(RQ_ROTATE_MAGIC));
+
+    ggml_tensor * matmul_args[] = { qweight, rotated };
+    return ggml_custom_4d(
+        ctx,
+        GGML_TYPE_F32,
+        qweight->ne[1], input->ne[1], input->ne[2], input->ne[3],
+        matmul_args, 2,
+        compute_rotquant_mul_mat,
+        GGML_N_TASKS_MAX,
+        reinterpret_cast<void *>(RQ_MUL_MAT_MAGIC));
+}
+
+ggml_tensor * llama_rotquant_get_rows(
+        ggml_context * ctx,
+        ggml_tensor  * qweight,
+        ggml_tensor  * indices,
+        ggml_tensor  * rotation) {
+    GGML_ASSERT(qweight->type == GGML_TYPE_I8);
+    GGML_ASSERT(indices->type == GGML_TYPE_I64);
+    GGML_ASSERT(rotation->type == GGML_TYPE_F32);
+    const int64_t n_embd = qweight->ne[0] / RQ_BLOCK_BYTES * RQ_GROUP_SIZE;
+    GGML_ASSERT(qweight->ne[0] % RQ_BLOCK_BYTES == 0);
+    GGML_ASSERT(rotation->ne[0] == n_embd
+        + n_embd / 2 * RQ_ROTATION_STAGES);
+
+    ggml_tensor * args[] = { qweight, indices, rotation };
+    return ggml_custom_4d(
+        ctx,
+        GGML_TYPE_F32,
+        n_embd, ggml_nelements(indices), 1, 1,
+        args, 3,
+        compute_rotquant_get_rows,
+        GGML_N_TASKS_MAX,
+        reinterpret_cast<void *>(RQ_GET_ROWS_MAGIC));
+}
+
+size_t llama_rotquant_kv_row_size(int64_t n_embd_gqa, int bits) {
+    GGML_ASSERT(bits >= 2 && bits <= 4);
+    GGML_ASSERT(n_embd_gqa % RQ_KV_GROUP_SIZE == 0);
+    return n_embd_gqa/RQ_KV_GROUP_SIZE*
+        (RQ_SCALE_BYTES + RQ_KV_GROUP_SIZE*bits/8);
+}
+
+ggml_tensor * llama_rotquant_kv_store(
+        ggml_context * ctx,
+        ggml_tensor  * cache,
+        ggml_tensor  * current,
+        ggml_tensor  * indices,
+                  int bits,
+                 bool value) {
+    GGML_ASSERT(cache->type == GGML_TYPE_I8);
+    GGML_ASSERT(indices->type == GGML_TYPE_I64);
+    GGML_ASSERT(current->ne[0] % RQ_ROTATION_BLOCK == 0);
+    GGML_ASSERT(cache->ne[0] == static_cast<int64_t>(
+        llama_rotquant_kv_row_size(current->ne[0]*current->ne[1], bits)));
+    ggml_tensor * args[] = { current, indices };
+    return ggml_custom_inplace(
+        ctx, cache, args, 2, compute_rotquant_kv_store, GGML_N_TASKS_MAX,
+        reinterpret_cast<void *>(value ? RQ_KV_STORE_V_MAGIC : RQ_KV_STORE_K_MAGIC));
+}
+
+ggml_tensor * llama_rotquant_kv_load(
+        ggml_context * ctx,
+        ggml_tensor  * packed,
+              int64_t n_embd_head,
+              int64_t n_head,
+                  int bits,
+                 bool value) {
+    GGML_ASSERT(packed->type == GGML_TYPE_I8);
+    GGML_ASSERT(n_embd_head % RQ_ROTATION_BLOCK == 0);
+    GGML_ASSERT(packed->ne[0] == static_cast<int64_t>(
+        llama_rotquant_kv_row_size(n_embd_head*n_head, bits)));
+    ggml_tensor * args[] = { packed };
+    return ggml_custom_4d(
+        ctx, GGML_TYPE_F16,
+        n_embd_head, n_head, packed->ne[1], packed->ne[2],
+        args, 1, compute_rotquant_kv_load, GGML_N_TASKS_MAX,
+        reinterpret_cast<void *>(value ? RQ_KV_LOAD_V_MAGIC : RQ_KV_LOAD_K_MAGIC));
+}
