diff --git a/src/llama-rotquant.cpp b/src/llama-rotquant.cpp
new file mode 100644
index 000000000..4d60c1751
--- /dev/null
+++ b/src/llama-rotquant.cpp
@@ -0,0 +1,195 @@
+#include "llama-rotquant.h"
+
+#include "ggml.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+namespace {
+
+constexpr int64_t RQ_GROUP_SIZE = 128;
+constexpr int64_t RQ_CODE_BYTES = 64;
+constexpr int64_t RQ_SCALE_BYTES = 2;
+constexpr int64_t RQ_BLOCK_BYTES = RQ_SCALE_BYTES + RQ_CODE_BYTES;
+constexpr int64_t RQ_ROTATION_BLOCK = 128;
+constexpr int64_t RQ_ROTATION_STAGES = 7;
+// Host-side tags consumed by the Metal backend. They are values, not pointers
+// to storage, and are never dereferenced.
+constexpr uintptr_t RQ_ROTATE_MAGIC = 0x5251524f54415445ULL; // "RQROTATE"
+constexpr uintptr_t RQ_MUL_MAT_MAGIC = 0x52514d554c4d4154ULL; // "RQMULMAT"
+
+// rotquant.codebooks.lloyd_max_gaussian(16), rounded once to float32.
+constexpr float RQ_CODEBOOK[16] = {
+    -2.7338738441467285f, -2.0704751014709473f,
+    -1.6195980310440063f, -1.2577794790267944f,
+    -0.9437850117683411f, -0.6579855084419250f,
+    -0.3889232873916626f, -0.1287587136030197f,
+     0.1286393851041794f,  0.3888039886951447f,
+     0.6578662991523743f,  0.9436659216880798f,
+     1.2576605081558228f,  1.6195257902145386f,
+     2.0704751014709473f,  2.7338738441467285f,
+};
+
+const char * row_ptr(const ggml_tensor * tensor, int64_t row) {
+    int64_t i1 = row % tensor->ne[1];
+    row /= tensor->ne[1];
+    int64_t i2 = row % tensor->ne[2];
+    int64_t i3 = row / tensor->ne[2];
+    return static_cast<const char *>(tensor->data)
+        + i1 * tensor->nb[1] + i2 * tensor->nb[2] + i3 * tensor->nb[3];
+}
+
+char * row_ptr(ggml_tensor * tensor, int64_t row) {
+    return const_cast<char *>(row_ptr(const_cast<const ggml_tensor *>(tensor), row));
+}
+
+void rotate_activation(
+        std::vector<float> & values,
+        const float        * rotation,
+        int64_t              n_embd) {
+    const float * signs = rotation;
+    const float * theta = rotation + n_embd;
+    const int64_t n_blocks = n_embd / RQ_ROTATION_BLOCK;
+
+    for (int64_t i = 0; i < n_embd; ++i) {
+        values[i] *= signs[i];
+    }
+
+    for (int64_t stage = 0; stage < RQ_ROTATION_STAGES; ++stage) {
+        const int64_t step = int64_t(1) << stage;
+        const int64_t groups = RQ_ROTATION_BLOCK / (2 * step);
+        for (int64_t block = 0; block < n_blocks; ++block) {
+            const int64_t block_base = block * RQ_ROTATION_BLOCK;
+            const float * stage_theta = theta
+                + (block * RQ_ROTATION_STAGES + stage) * (RQ_ROTATION_BLOCK / 2);
+            for (int64_t group = 0; group < groups; ++group) {
+                for (int64_t j = 0; j < step; ++j) {
+                    const int64_t pair = group * step + j;
+                    const int64_t ia = block_base + group * 2 * step + j;
+                    const int64_t ib = ia + step;
+                    const float a = values[ia];
+                    const float b = values[ib];
+                    const float c = std::cos(stage_theta[pair]);
+                    const float s = std::sin(stage_theta[pair]);
+                    values[ia] = c * a + s * b;
+                    values[ib] = s * a - c * b;
+                }
+            }
+        }
+    }
+}
+
+void compute_rotquant_rotate(
+        ggml_tensor * dst,
+        int           ith,
+        int           nth,
+        void        *) {
+    const ggml_tensor * input = dst->src[0];
+    const ggml_tensor * rotation = dst->src[1];
+
+    const int64_t n_embd = input->ne[0];
+    const int64_t n_rows = ggml_nrows(input);
+    const float * rotation_data = static_cast<const float *>(rotation->data);
+
+    std::vector<float> rotated(n_embd);
+    for (int64_t token = ith; token < n_rows; token += nth) {
+        const void * input_row = row_ptr(input, token);
+        if (input->type == GGML_TYPE_F32) {
+            std::memcpy(rotated.data(), input_row, n_embd * sizeof(float));
+        } else if (input->type == GGML_TYPE_F16) {
+            const ggml_fp16_t * values = static_cast<const ggml_fp16_t *>(input_row);
+            for (int64_t i = 0; i < n_embd; ++i) {
+                rotated[i] = ggml_fp16_to_fp32(values[i]);
+            }
+        } else if (input->type == GGML_TYPE_BF16) {
+            const ggml_bf16_t * values = static_cast<const ggml_bf16_t *>(input_row);
+            for (int64_t i = 0; i < n_embd; ++i) {
+                rotated[i] = ggml_bf16_to_fp32(values[i]);
+            }
+        } else {
+            const ggml_type_traits * traits = ggml_get_type_traits(input->type);
+            GGML_ASSERT(traits != nullptr && traits->to_float != nullptr);
+            traits->to_float(input_row, rotated.data(), n_embd);
+        }
+        rotate_activation(rotated, rotation_data, n_embd);
+        std::memcpy(row_ptr(dst, token), rotated.data(), n_embd * sizeof(float));
+    }
+}
+
+void compute_rotquant_mul_mat(
+        ggml_tensor * dst,
+        int           ith,
+        int           nth,
+        void        *) {
+    const ggml_tensor * qweight = dst->src[0];
+    const ggml_tensor * input = dst->src[1];
+
+    const int64_t n_embd = input->ne[0];
+    const int64_t n_groups = n_embd / RQ_GROUP_SIZE;
+    const int64_t n_outputs = qweight->ne[1];
+    const int64_t n_rows = ggml_nrows(input);
+
+    for (int64_t token = 0; token < n_rows; ++token) {
+        const float * rotated = reinterpret_cast<const float *>(row_ptr(input, token));
+        for (int64_t output = ith; output < n_outputs; output += nth) {
+            const uint8_t * qrow = reinterpret_cast<const uint8_t *>(qweight->data)
+                + output * qweight->nb[1];
+            float sum = 0.0f;
+            for (int64_t group = 0; group < n_groups; ++group) {
+                const uint8_t * packed = qrow + group * RQ_BLOCK_BYTES;
+                ggml_fp16_t scale_bits;
+                std::memcpy(&scale_bits, packed, sizeof(scale_bits));
+                const float scale = ggml_fp16_to_fp32(scale_bits);
+                const uint8_t * codes = packed + RQ_SCALE_BYTES;
+                const int64_t input_base = group * RQ_GROUP_SIZE;
+                float group_sum = 0.0f;
+                for (int64_t j = 0; j < RQ_CODE_BYTES; ++j) {
+                    const uint8_t pair = codes[j];
+                    group_sum += RQ_CODEBOOK[pair & 0x0f] * rotated[input_base + 2*j + 0];
+                    group_sum += RQ_CODEBOOK[pair >> 4]   * rotated[input_base + 2*j + 1];
+                }
+                sum += scale * group_sum;
+            }
+            float * output_row = reinterpret_cast<float *>(row_ptr(dst, token));
+            output_row[output] = sum;
+        }
+    }
+}
+
+} // namespace
+
+ggml_tensor * llama_rotquant_mul_mat(
+        ggml_context * ctx,
+        ggml_tensor  * qweight,
+        ggml_tensor  * input,
+        ggml_tensor  * rotation) {
+    GGML_ASSERT(qweight->type == GGML_TYPE_I8);
+    GGML_ASSERT(rotation->type == GGML_TYPE_F32);
+    GGML_ASSERT(input->ne[0] % RQ_GROUP_SIZE == 0);
+    GGML_ASSERT(qweight->ne[0] == input->ne[0] / RQ_GROUP_SIZE * RQ_BLOCK_BYTES);
+    GGML_ASSERT(rotation->ne[0] == input->ne[0]
+        + input->ne[0] / 2 * RQ_ROTATION_STAGES);
+
+    ggml_tensor * rotate_args[] = { input, rotation };
+    ggml_tensor * rotated = ggml_custom_4d(
+        ctx,
+        GGML_TYPE_F32,
+        input->ne[0], input->ne[1], input->ne[2], input->ne[3],
+        rotate_args, 2,
+        compute_rotquant_rotate,
+        GGML_N_TASKS_MAX,
+        reinterpret_cast<void *>(RQ_ROTATE_MAGIC));
+
+    ggml_tensor * matmul_args[] = { qweight, rotated };
+    return ggml_custom_4d(
+        ctx,
+        GGML_TYPE_F32,
+        qweight->ne[1], input->ne[1], input->ne[2], input->ne[3],
+        matmul_args, 2,
+        compute_rotquant_mul_mat,
+        GGML_N_TASKS_MAX,
+        reinterpret_cast<void *>(RQ_MUL_MAT_MAGIC));
+}
