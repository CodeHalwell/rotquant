+            /* .value      = */ magic == GGML_METAL_RQ_KV_LOAD_V_MAGIC,
+        };
+        auto pipeline = ggml_metal_library_get_pipeline_rotquant_kv_load(lib);
+        ggml_metal_encoder_set_pipeline(enc, pipeline);
+        ggml_metal_encoder_set_bytes(enc, &args, sizeof(args), 0);
+        ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(packed), 1);
+        ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(op),     2);
+        ggml_metal_encoder_dispatch_threadgroups(
+            enc, op->ne[1] * op->ne[0] / 128, packed->ne[1] * packed->ne[2], 1, 128, 1, 1);
+        return 1;
+    }
