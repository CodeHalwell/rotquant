+int ggml_metal_op_rotquant(ggml_metal_op_t ctx, int idx) {
+    ggml_tensor * op = ctx->node(idx);
+    ggml_metal_library_t lib = ctx->lib;
+    ggml_metal_encoder_t enc = ctx->enc;
+
+    const ggml_custom_op_params * params =
+        reinterpret_cast<const ggml_custom_op_params *>(op->op_params);
+    const uintptr_t magic = reinterpret_cast<uintptr_t>(params->userdata);
+
+    if (magic == GGML_METAL_RQ_ROTATE_MAGIC) {
+        const ggml_tensor * input = op->src[0];
+        const ggml_tensor * rotation = op->src[1];
+        ggml_metal_kargs_rotquant_rotate args = {
+            /* .n_embd = */ input->ne[0],
+            /* .n_rows = */ ggml_nrows(input),
+            /* .ne01   = */ input->ne[1],
+            /* .ne02   = */ input->ne[2],
+            /* .nb01   = */ input->nb[1],
+            /* .nb02   = */ input->nb[2],
+            /* .nb03   = */ input->nb[3],
+            /* .nb1    = */ op->nb[1],
+            /* .nb2    = */ op->nb[2],
+            /* .nb3    = */ op->nb[3],
+        };
+        auto pipeline = ggml_metal_library_get_pipeline_rotquant_rotate(lib, input->type);
+        ggml_metal_encoder_set_pipeline(enc, pipeline);
+        ggml_metal_encoder_set_bytes(enc, &args, sizeof(args), 0);
+        ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(input),    1);
+        ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(rotation), 2);
+        ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(op),       3);
+        ggml_metal_encoder_dispatch_threadgroups(
+            enc, input->ne[0] / 128, ggml_nrows(input), 1, 128, 1, 1);
+        return 1;
+    }
+
+    GGML_ASSERT(magic == GGML_METAL_RQ_MUL_MAT_MAGIC);
+    const ggml_tensor * qweight = op->src[0];
+    const ggml_tensor * input = op->src[1];
+    ggml_metal_kargs_rotquant_mul_mv args = {
+        /* .n_embd   = */ input->ne[0],
+        /* .n_outputs= */ qweight->ne[1],
+        /* .n_rows   = */ ggml_nrows(input),
+        /* .ne11     = */ input->ne[1],
+        /* .ne12     = */ input->ne[2],
+        /* .nb01     = */ qweight->nb[1],
+        /* .nb11     = */ input->nb[1],
+        /* .nb12     = */ input->nb[2],
+        /* .nb13     = */ input->nb[3],
+        /* .nb1      = */ op->nb[1],
+        /* .nb2      = */ op->nb[2],
+        /* .nb3      = */ op->nb[3],
+    };
+    constexpr int64_t nsg = 4;
+    auto pipeline = ggml_metal_library_get_pipeline_rotquant_mul_mv(lib);
+    ggml_metal_encoder_set_pipeline(enc, pipeline);
+    ggml_metal_encoder_set_bytes(enc, &args, sizeof(args), 0);
+    ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(qweight), 1);
+    ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(input),   2);
+    ggml_metal_encoder_set_buffer(enc, ggml_metal_get_buffer_id(op),      3);
+    ggml_metal_encoder_dispatch_threadgroups(
+        enc, (qweight->ne[1] + nsg - 1) / nsg, ggml_nrows(input), 1, 32 * nsg, 1, 1);
+    return 1;
+}
