+#include "common.h"
+
+constant float rotquant_codebook[16] = {
+    -2.7338738441467285f, -2.0704751014709473f,
+    -1.6195980310440063f, -1.2577794790267944f,
+    -0.9437850117683411f, -0.6579855084419250f,
+    -0.3889232873916626f, -0.1287587136030197f,
+     0.1286393851041794f,  0.3888039886951447f,
+     0.6578662991523743f,  0.9436659216880798f,
+     1.2576605081558228f,  1.6195257902145386f,
+     2.0704751014709473f,  2.7338738441467285f,
+};
+
+template<typename T>
+kernel void kernel_rotquant_rotate(
+        constant ggml_metal_kargs_rotquant_rotate & args,
+        device const char  * src_bytes,
+        device const float * rotation,
+        device       char  * dst_bytes,
+        uint3 tgpig [[threadgroup_position_in_grid]],
+        uint  tid   [[thread_index_in_threadgroup]]) {
+    constexpr uint block_size = 128;
+    constexpr uint stages = 7;
+
+    const int64_t block = tgpig.x;
+    const int64_t row = tgpig.y;
+    if (row >= args.n_rows || block * block_size >= args.n_embd) {
+        return;
+    }
+
+    int64_t r = row;
+    const int64_t i1 = r % args.ne01;
+    r /= args.ne01;
+    const int64_t i2 = r % args.ne02;
+    const int64_t i3 = r / args.ne02;
+
+    const device T * src = reinterpret_cast<device const T *>(
+        src_bytes + i1 * args.nb01 + i2 * args.nb02 + i3 * args.nb03);
+    device float * dst = reinterpret_cast<device float *>(
+        dst_bytes + i1 * args.nb1 + i2 * args.nb2 + i3 * args.nb3);
+
+    threadgroup float ping[block_size];
+    threadgroup float pong[block_size];
+    const int64_t element = block * block_size + tid;
+    ping[tid] = float(src[element]) * rotation[element];
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    for (uint stage = 0; stage < stages; ++stage) {
+        const uint step = 1u << stage;
+        const uint span = 2u * step;
+        const uint group = tid / span;
+        const uint within = tid % span;
+        const uint j = within % step;
+        const uint ia = group * span + j;
+        const uint ib = ia + step;
+        const uint pair = group * step + j;
+        const int64_t theta_index = args.n_embd
+            + (block * stages + stage) * (block_size / 2) + pair;
+        const float theta = rotation[theta_index];
+        const float c = cos(theta);
+        const float s = sin(theta);
+        const threadgroup float * in = (stage & 1u) ? pong : ping;
+        threadgroup float * out = (stage & 1u) ? ping : pong;
+        const float a = in[ia];
+        const float b = in[ib];
+        out[tid] = within < step ? c * a + s * b : s * a - c * b;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+
+    // Seven stages leave the result in pong.
+    dst[element] = pong[tid];
+}
+
+kernel void kernel_rotquant_mul_mv_f32(
+        constant ggml_metal_kargs_rotquant_mul_mv & args,
+        device const uchar * qweight,
+        device const char  * input_bytes,
+        device       char  * dst_bytes,
+        uint3  tgpig [[threadgroup_position_in_grid]],
+        ushort sgitg [[simdgroup_index_in_threadgroup]],
+        ushort lane  [[thread_index_in_simdgroup]],
+        ushort3 ntg  [[threads_per_threadgroup]]) {
+    const int64_t output = tgpig.x * (ntg.x / 32) + sgitg;
+    const int64_t row = tgpig.y;
+    if (output >= args.n_outputs || row >= args.n_rows) {
+        return;
+    }
+
+    int64_t r = row;
+    const int64_t i1 = r % args.ne11;
+    r /= args.ne11;
+    const int64_t i2 = r % args.ne12;
+    const int64_t i3 = r / args.ne12;
+
+    const device float * input = reinterpret_cast<device const float *>(
+        input_bytes + i1 * args.nb11 + i2 * args.nb12 + i3 * args.nb13);
+    device float * dst = reinterpret_cast<device float *>(
+        dst_bytes + i1 * args.nb1 + i2 * args.nb2 + i3 * args.nb3);
+    const device uchar * qrow = qweight + output * args.nb01;
+
+    constexpr int64_t group_size = 128;
+    constexpr int64_t code_bytes = 64;
+    constexpr int64_t block_bytes = 66;
+    const int64_t n_groups = args.n_embd / group_size;
+    float sum = 0.0f;
+    for (int64_t group = 0; group < n_groups; ++group) {
+        const device uchar * packed = qrow + group * block_bytes;
+        const float scale = float(*reinterpret_cast<device const half *>(packed));
+        const device uchar * codes = packed + 2;
+        const int64_t input_base = group * group_size;
+        for (int64_t j = lane; j < code_bytes; j += 32) {
+            const uchar pair = codes[j];
+            sum += scale * (
+                rotquant_codebook[pair & 0x0f] * input[input_base + 2*j] +
+                rotquant_codebook[pair >> 4]   * input[input_base + 2*j + 1]);
+        }
+    }
+
+    sum = simd_sum(sum);
+    if (lane == 0) {
+        dst[output] = sum;
+    }
+}
+
+kernel void kernel_rotquant_get_rows_f32(
+        constant ggml_metal_kargs_rotquant_get_rows & args,
+        device const uchar * qweight,
+        device const int   * indices,
+        device const float * rotation,
+        device       char  * dst_bytes,
+        uint3 tgpig [[threadgroup_position_in_grid]],
+        uint  tid   [[thread_index_in_threadgroup]]) {
+    constexpr uint block_size = 128;
+    constexpr uint stages = 7;
+    constexpr uint block_bytes = 66;
+    const int64_t block = tgpig.x;
+    const int64_t row = tgpig.y;
+    if (row >= args.n_rows || block * block_size >= args.n_embd) {
+        return;
+    }
+    const int token = indices[row];
+    if (token < 0 || token >= args.n_vocab) {
+        return;
+    }
+
+    const device uchar * packed = qweight
+        + int64_t(token) * args.nb01 + block * block_bytes;
+    const float scale = float(*reinterpret_cast<device const half *>(packed));
+    const uchar pair = packed[2 + tid / 2];
+    const uchar code = (tid & 1u) ? (pair >> 4) : (pair & 0x0f);
+    threadgroup float ping[block_size];
+    threadgroup float pong[block_size];
+    ping[tid] = scale * rotquant_codebook[code];
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    for (uint iteration = 0; iteration < stages; ++iteration) {
+        const uint stage = stages - 1 - iteration;
+        const uint step = 1u << stage;
+        const uint span = 2u * step;
+        const uint group = tid / span;
+        const uint within = tid % span;
+        const uint j = within % step;
+        const uint ia = group * span + j;
+        const uint ib = ia + step;
+        const uint pair_index = group * step + j;
+        const int64_t theta_index = args.n_embd
+            + (block * stages + stage) * (block_size / 2) + pair_index;
+        const float theta = rotation[theta_index];
+        const float c = cos(theta);
+        const float s = sin(theta);
+        const threadgroup float * in = (iteration & 1u) ? pong : ping;
+        threadgroup float * out = (iteration & 1u) ? ping : pong;
+        const float a = in[ia];
+        const float b = in[ib];
+        out[tid] = within < step ? c * a + s * b : s * a - c * b;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+
+    device float * dst = reinterpret_cast<device float *>(
+        dst_bytes + row * args.nb1);
+    const int64_t element = block * block_size + tid;
+    dst[element] = pong[tid] * rotation[element];
+}
+
+constant float rotquant_kv_codebook_2[4] = {
+    -1.510466456413269f, -0.45277151465415955f,
+     0.4528822898864746f, 1.5105623006820679f,
+};
+
+constant float rotquant_kv_codebook_3[8] = {
+    -2.1523044109344482f, -1.3442617654800415f,
+    -0.7562991976737976f, -0.2452515810728073f,
+     0.24513407051563263f, 0.7562323808670044f,
+     1.3442617654800415f, 2.1523044109344482f,
+};
+
+constant uint rotquant_kv_key_signs[8] = {
+    0x5e6827f6u, 0x597afa6du, 0x4dfa58c1u, 0xdf505896u,
+    0xba3d309bu, 0x41515534u, 0x8a0c6522u, 0xdc7a58f3u,
+};
+
+constant uint rotquant_kv_value_signs[8] = {
+    0x112269f3u, 0x65c9bf1fu, 0x72d970cfu, 0x7e07f07bu,
+    0x42e2be26u, 0x0846481du, 0xf7637073u, 0xcfd5db52u,
+};
+
+static inline float rotquant_kv_codebook_value(int bits, uint code) {
+    if (bits == 2) {
+        return rotquant_kv_codebook_2[code];
+    }
+    if (bits == 3) {
+        return rotquant_kv_codebook_3[code];
+    }
+    return rotquant_codebook[code];
+}
+
+static inline float rotquant_kv_sign(uint element, int value) {
+    const uint word = value ? rotquant_kv_value_signs[(element % 256) / 32]
+                            : rotquant_kv_key_signs[(element % 256) / 32];
+    return ((word >> (element % 32)) & 1u) ? 1.0f : -1.0f;
+}
+
+static inline uchar rotquant_kv_nearest(float value, int bits) {
+    uchar best = 0;
+    float best_error = fabs(value - rotquant_kv_codebook_value(bits, 0));
+    for (int i = 1; i < (1 << bits); ++i) {
+        const float error = fabs(value - rotquant_kv_codebook_value(bits, uint(i)));
+        if (error < best_error) {
+            best = uchar(i);
+            best_error = error;
+        }
+    }
+    return best;
+}
+
+template<typename T>
+kernel void kernel_rotquant_kv_store(
+        constant ggml_metal_kargs_rotquant_kv_store & args,
+        device const char      * current_bytes,
+        device const long      * indices,
+        device       uchar     * cache,
+        uint3 tgpig [[threadgroup_position_in_grid]],
+        uint  tid   [[thread_index_in_threadgroup]]) {
+    constexpr uint block_size = 128;
+    constexpr uint group_size = 64;
+    constexpr float norm = 0.08838834764831845f;
+    const int64_t n_blocks = args.n_embd_head / block_size;
+    const int64_t head = tgpig.x / n_blocks;
+    const int64_t block = tgpig.x % n_blocks;
+    const int64_t token = tgpig.y;
+    if (head >= args.n_head || token >= args.n_tokens) {
+        return;
+    }
+    const int64_t cache_row = indices[token];
+    if (cache_row < 0 || cache_row >= args.n_cache_rows) {
+        return;
+    }
+
+    const device T * current = reinterpret_cast<device const T *>(
+        current_bytes + head * args.nb_current1 + token * args.nb_current2);
+    const uint element = uint(block * block_size) + tid;
+    threadgroup float ping[block_size];
+    threadgroup float pong[block_size];
+    ping[tid] = float(current[element]) * rotquant_kv_sign(element, args.value);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    for (uint stage = 0; stage < 7; ++stage) {
+        const uint step = 1u << stage;
+        const uint span = 2u * step;
+        const uint group = tid / span;
+        const uint within = tid % span;
+        const uint j = within % step;
+        const uint ia = group * span + j;
+        const uint ib = ia + step;
+        const threadgroup float * input = (stage & 1u) ? pong : ping;
+        threadgroup float * output = (stage & 1u) ? ping : pong;
+        output[tid] = within < step ? input[ia] + input[ib] : input[ia] - input[ib];
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    pong[tid] *= norm;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    if (tid == 0 || tid == group_size) {
+        const uint local_group = tid / group_size;
+        const int code_bytes = int(group_size) * args.bits / 8;
+        const int group_bytes = 2 + code_bytes;
+        const int groups_per_head = int(args.n_embd_head) / int(group_size);
+        const int head_bytes = groups_per_head * group_bytes;
+        const int group_index = int(block) * 2 + int(local_group);
+        device uchar * packed = cache + cache_row * args.nb_cache1
+            + head * head_bytes + group_index * group_bytes;
+        float sum_sq = 0.0f;
+        for (uint j = 0; j < group_size; ++j) {
+            const float value = pong[local_group * group_size + j];
+            sum_sq += value * value;
+        }
+        const half scale_half = half(max(sqrt(sum_sq / float(group_size)), 6.103515625e-5f));
+        *reinterpret_cast<device half *>(packed) = scale_half;
+        device uchar * codes = packed + 2;
+        for (int j = 0; j < code_bytes; ++j) {
+            codes[j] = 0;
+        }
+        const float scale = float(scale_half);
+        for (uint j = 0; j < group_size; ++j) {
+            const uchar code = rotquant_kv_nearest(
+                pong[local_group * group_size + j] / scale, args.bits);
+            const int bit = int(j) * args.bits;
+            const int byte = bit / 8;
+            const int shift = bit % 8;
+            const ushort encoded = ushort(code) << shift;
+            codes[byte] |= uchar(encoded);
+            if (shift + args.bits > 8) {
+                codes[byte + 1] |= uchar(encoded >> 8);
+            }
+        }
+    }
+}
+
+kernel void kernel_rotquant_kv_load_f16(
+        constant ggml_metal_kargs_rotquant_kv_load & args,
+        device const uchar * packed_cache,
+        device       char  * output_bytes,
+        uint3 tgpig [[threadgroup_position_in_grid]],
+        uint  tid   [[thread_index_in_threadgroup]]) {
+    constexpr uint block_size = 128;
+    constexpr uint group_size = 64;
+    constexpr float norm = 0.08838834764831845f;
+    const int64_t n_blocks = args.n_embd_head / block_size;
+    const int64_t head = tgpig.x / n_blocks;
+    const int64_t block = tgpig.x % n_blocks;
+    const int64_t row = tgpig.y;
+    if (head >= args.n_head || row >= args.n_rows) {
+        return;
+    }
+    const int64_t token = row % args.ne_packed1;
+    const int64_t stream = row / args.ne_packed1;
+    const int code_bytes = int(group_size) * args.bits / 8;
+    const int group_bytes = 2 + code_bytes;
+    const int groups_per_head = int(args.n_embd_head) / int(group_size);
+    const int head_bytes = groups_per_head * group_bytes;
+    const uint local_group = tid / group_size;
+    const uint j = tid % group_size;
+    const int group_index = int(block) * 2 + int(local_group);
+    const device uchar * packed = packed_cache
+        + token * args.nb_packed1 + stream * args.nb_packed2
+        + head * head_bytes + group_index * group_bytes;
+    const float scale = float(*reinterpret_cast<device const half *>(packed));
+    const device uchar * codes = packed + 2;
+    const int bit = int(j) * args.bits;
+    const int byte = bit / 8;
+    const int shift = bit % 8;
+    ushort encoded = codes[byte];
+    if (shift + args.bits > 8) {
+        encoded |= ushort(codes[byte + 1]) << 8;
+    }
+    const uint code = (encoded >> shift) & ((1u << args.bits) - 1u);
+
+    threadgroup float ping[block_size];
+    threadgroup float pong[block_size];
+    ping[tid] = scale * rotquant_kv_codebook_value(args.bits, code);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (uint stage = 0; stage < 7; ++stage) {
+        const uint step = 1u << stage;
+        const uint span = 2u * step;
+        const uint group = tid / span;
+        const uint within = tid % span;
+        const uint pair = within % step;
+        const uint ia = group * span + pair;
+        const uint ib = ia + step;
+        const threadgroup float * input = (stage & 1u) ? pong : ping;
+        threadgroup float * output = (stage & 1u) ? ping : pong;
+        output[tid] = within < step ? input[ia] + input[ib] : input[ia] - input[ib];
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+
+    device half * output = reinterpret_cast<device half *>(
+        output_bytes + head * args.nb1 + token * args.nb2 + stream * args.nb3);
+    output[block * block_size + tid] = half(
+        pong[tid] * norm * rotquant_kv_sign(uint(block * block_size) + tid, args.value));
+}
+
+typedef decltype(kernel_rotquant_rotate<float>) kernel_rotquant_rotate_t;
+template [[host_name("kernel_rotquant_rotate_f32")]] kernel kernel_rotquant_rotate_t kernel_rotquant_rotate<float>;
+template [[host_name("kernel_rotquant_rotate_f16")]] kernel kernel_rotquant_rotate_t kernel_rotquant_rotate<half>;
+#if defined(GGML_METAL_HAS_BF16)
+template [[host_name("kernel_rotquant_rotate_bf16")]] kernel kernel_rotquant_rotate_t kernel_rotquant_rotate<bfloat>;
+#endif
+
+typedef decltype(kernel_rotquant_kv_store<float>) kernel_rotquant_kv_store_t;
+template [[host_name("kernel_rotquant_kv_store_f32")]] kernel kernel_rotquant_kv_store_t kernel_rotquant_kv_store<float>;
+template [[host_name("kernel_rotquant_kv_store_f16")]] kernel kernel_rotquant_kv_store_t kernel_rotquant_kv_store<half>;
+#if defined(GGML_METAL_HAS_BF16)
+template [[host_name("kernel_rotquant_kv_store_bf16")]] kernel kernel_rotquant_kv_store_t kernel_rotquant_kv_store<bfloat>;
+#endif
