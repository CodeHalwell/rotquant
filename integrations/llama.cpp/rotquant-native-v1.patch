diff --git a/ggml/src/ggml-metal/kernels/rotquant.metal b/ggml/src/ggml-metal/kernels/rotquant.metal
new file mode 100644
index 000000000..2e123dc00
--- /dev/null
+++ b/ggml/src/ggml-metal/kernels/rotquant.metal
@@ -0,0 +1,130 @@
+#include "common.h"
+
+constant float rotquant_codebook[16] = {
+    -2.7338738441467285f, -2.0704751014709473f,
+    -1.6195980310440063f, -1.2577794790267944f,
+    -0.9437850117683411f, -0.6579855084419250f,
+    -0.3889232873916626f, -0.1287587136030197f,
+     0.1286393851041794f,  0.3888039886951447f,
+     0.6578662991523743f,  0.9436659216880798f,
+     1.2576605081558228f,  1.6195257902145386f,
+     2.0704751014709473f,  2.7338738441467285f,
+};
+
+template<typename T>
+kernel void kernel_rotquant_rotate(
+        constant ggml_metal_kargs_rotquant_rotate & args,
+        device const char  * src_bytes,
+        device const float * rotation,
+        device       char  * dst_bytes,
+        uint3 tgpig [[threadgroup_position_in_grid]],
+        uint  tid   [[thread_index_in_threadgroup]]) {
+    constexpr uint block_size = 128;
+    constexpr uint stages = 7;
+
+    const int64_t block = tgpig.x;
+    const int64_t row = tgpig.y;
+    if (row >= args.n_rows || block * block_size >= args.n_embd) {
+        return;
+    }
+
+    int64_t r = row;
+    const int64_t i1 = r % args.ne01;
+    r /= args.ne01;
+    const int64_t i2 = r % args.ne02;
+    const int64_t i3 = r / args.ne02;
+
+    const device T * src = reinterpret_cast<device const T *>(
+        src_bytes + i1 * args.nb01 + i2 * args.nb02 + i3 * args.nb03);
+    device float * dst = reinterpret_cast<device float *>(
+        dst_bytes + i1 * args.nb1 + i2 * args.nb2 + i3 * args.nb3);
+
+    threadgroup float ping[block_size];
+    threadgroup float pong[block_size];
+    const int64_t element = block * block_size + tid;
+    ping[tid] = float(src[element]) * rotation[element];
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    for (uint stage = 0; stage < stages; ++stage) {
+        const uint step = 1u << stage;
+        const uint span = 2u * step;
+        const uint group = tid / span;
+        const uint within = tid % span;
+        const uint j = within % step;
+        const uint ia = group * span + j;
+        const uint ib = ia + step;
+        const uint pair = group * step + j;
+        const int64_t theta_index = args.n_embd
+            + (block * stages + stage) * (block_size / 2) + pair;
+        const float theta = rotation[theta_index];
+        const float c = cos(theta);
+        const float s = sin(theta);
+        const threadgroup float * in = (stage & 1u) ? pong : ping;
+        threadgroup float * out = (stage & 1u) ? ping : pong;
+        const float a = in[ia];
+        const float b = in[ib];
+        out[tid] = within < step ? c * a + s * b : s * a - c * b;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+
+    // Seven stages leave the result in pong.
+    dst[element] = pong[tid];
+}
+
+kernel void kernel_rotquant_mul_mv_f32(
+        constant ggml_metal_kargs_rotquant_mul_mv & args,
+        device const uchar * qweight,
+        device const char  * input_bytes,
+        device       char  * dst_bytes,
+        uint3  tgpig [[threadgroup_position_in_grid]],
+        ushort sgitg [[simdgroup_index_in_threadgroup]],
+        ushort lane  [[thread_index_in_simdgroup]],
+        ushort3 ntg  [[threads_per_threadgroup]]) {
+    const int64_t output = tgpig.x * (ntg.x / 32) + sgitg;
+    const int64_t row = tgpig.y;
+    if (output >= args.n_outputs || row >= args.n_rows) {
+        return;
+    }
+
+    int64_t r = row;
+    const int64_t i1 = r % args.ne11;
+    r /= args.ne11;
+    const int64_t i2 = r % args.ne12;
+    const int64_t i3 = r / args.ne12;
+
+    const device float * input = reinterpret_cast<device const float *>(
+        input_bytes + i1 * args.nb11 + i2 * args.nb12 + i3 * args.nb13);
+    device float * dst = reinterpret_cast<device float *>(
+        dst_bytes + i1 * args.nb1 + i2 * args.nb2 + i3 * args.nb3);
+    const device uchar * qrow = qweight + output * args.nb01;
+
+    constexpr int64_t group_size = 128;
+    constexpr int64_t code_bytes = 64;
+    constexpr int64_t block_bytes = 66;
+    const int64_t n_groups = args.n_embd / group_size;
+    float sum = 0.0f;
+    for (int64_t group = 0; group < n_groups; ++group) {
+        const device uchar * packed = qrow + group * block_bytes;
+        const float scale = float(*reinterpret_cast<device const half *>(packed));
+        const device uchar * codes = packed + 2;
+        const int64_t input_base = group * group_size;
+        for (int64_t j = lane; j < code_bytes; j += 32) {
+            const uchar pair = codes[j];
+            sum += scale * (
+                rotquant_codebook[pair & 0x0f] * input[input_base + 2*j] +
+                rotquant_codebook[pair >> 4]   * input[input_base + 2*j + 1]);
+        }
+    }
+
+    sum = simd_sum(sum);
+    if (lane == 0) {
+        dst[output] = sum;
+    }
+}
+
+typedef decltype(kernel_rotquant_rotate<float>) kernel_rotquant_rotate_t;
+template [[host_name("kernel_rotquant_rotate_f32")]] kernel kernel_rotquant_rotate_t kernel_rotquant_rotate<float>;
+template [[host_name("kernel_rotquant_rotate_f16")]] kernel kernel_rotquant_rotate_t kernel_rotquant_rotate<half>;
+#if defined(GGML_METAL_HAS_BF16)
+template [[host_name("kernel_rotquant_rotate_bf16")]] kernel kernel_rotquant_rotate_t kernel_rotquant_rotate<bfloat>;
+#endif
